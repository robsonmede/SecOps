Criar os volumes no Docker para o SonarQube

 docker volume create --name sonarqube_data
docker volume create --name sonarqube_extensions
docker volume create --name sonarqube_logs
docker volume create --name sonarqube_temp

Criar o Dockerfile:

vim Dockerfile

FROM sonarqube:8.9-community

Criar o .ENV:

vim .env

SONAR_JDBC_URL = "jdbc:postgresql://localhost:5432/userdb" \
SONAR_JDBC_USERNAME = "userdb" \
SONAR_JDBC_PASSWORD = "xxxxx" \

Salvar arquivo

Construir o container image:

docker build -t sonarqubecustom .

Executar o container com os parâmetros:

docker run -d --name sonarqube -p 9000:9000 -v sonarqube_data:/opt/sonarqube/data -v sonarqube_extensions:/opt/sonarqube/extensions -v sonarqube_logs:/opt/sonarqube/logs -v sonarqube_temp:/opt/sonarqube/temp -e sonar_jdbc_url=jdbc:postgresql://localhost:5432/sonar -e sonar_jdbc_username=sonar -e sonar_jdbc_password=sonar sonarqubecustom

